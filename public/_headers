# Hashed build output: the filename changes whenever the content does,
# so browsers and the CDN can keep these forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Optimized images (scripts/optimize-images.mjs) carry a content hash in the filename.
/optimized/*
  Cache-Control: public, max-age=31536000, immutable
