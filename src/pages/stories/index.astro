---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Clock, ArrowUpRight } from 'lucide-react';
import { ESSAYS_DATA } from '../../data/essays.js';
import Img from '../../components/Img.jsx';

// Categories come from each story's own `category` field. Only categories that
// have at least one story get a chip. Fiction is a separate piece (see below),
// so it gets a chip as well.
const ORDER = ['life', 'food', 'work'];
const present = [...new Set(ESSAYS_DATA.map((e) => String(e.category || '').toLowerCase()).filter(Boolean))];
const categories = [
  ...ORDER.filter((c) => present.includes(c)),
  ...present.filter((c) => !ORDER.includes(c) && c !== 'general'),
].map((c) => ({ key: c, label: c.charAt(0).toUpperCase() + c.slice(1) }));
categories.push({ key: 'fiction', label: 'Fiction' });
---

<BaseLayout
  title="Stories & Letters | 5 Spices or Less"
  description="Quiet essays by Vivek Shukla on work, kitchen, character and life, written from Lucknow to Kuala Lumpur on what endures after the rush subsides."
  ogKey="home"
  activeCategory="STORIES"
>
  <div class="min-h-screen pt-44 pb-24 px-6 md:px-12 bg-white dark:bg-canvas-dark text-ink-900 dark:text-white transition-colors duration-300">
    <div class="max-w-6xl mx-auto">
      
      {/* Header */}
      <div class="mb-14">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-berry-50 dark:bg-canvas-darkCard border border-berry-200 dark:border-canvas-darkBorder text-berry-700 dark:text-berry-400 text-xs font-mono uppercase tracking-widest font-bold mb-4">
          <span>THE STORIES &amp; LETTERS</span>
        </div>
        <h1 class="font-serif text-4xl sm:text-6xl font-black leading-tight text-ink-900 dark:text-white mb-4">
          Observations on work, kitchen, character &amp; life.
        </h1>
        <p class="text-lg text-ink-600 dark:text-ink-300 font-light max-w-2xl">
          Quiet thoughts written from Lucknow to Kuala Lumpur on what endures after the rush subsides.
        </p>
      </div>

      {/* Fiction spotlight */}
      <section id="fiction" data-fiction-spotlight aria-labelledby="fiction-spotlight-title" class="relative mb-14 rounded-3xl bg-[#F7F4F0] border border-[#E3DEC3] shadow-lg overflow-hidden">
        <div class="grid md:grid-cols-12 items-center">
          <div class="md:col-span-7 p-8 sm:p-12 space-y-4 order-2 md:order-1">
            <div class="flex flex-wrap items-center gap-3">
              <span class="text-xs font-mono uppercase tracking-widest font-bold text-[#A3434A]">Fiction</span>
              <span class="text-xs font-mono uppercase tracking-widest font-bold text-[#8A3A12] bg-white px-3 py-1 rounded-full border border-[#E3DEC3]">Coming soon</span>
            </div>
            <h2 id="fiction-spotlight-title" class="font-serif text-3xl sm:text-4xl font-bold text-[#111111] leading-tight">
              <a href="/stories/fiction/" class="hover:text-[#A3434A] transition-colors after:absolute after:inset-0 after:content-[''] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#C2185B]">Complete Silence Across the Bridge</a>
            </h2>
            <p class="font-serif italic text-lg text-[#55524E] border-l-2 border-[#BC5259] pl-4 py-1 max-w-xl">
              On an impulsive question, kilometres of quiet pavement, and how two strangers found their rhythm.
            </p>
            <p class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-widest font-bold text-[#A3434A]">
              <span>Read the teaser</span>
              <ArrowUpRight className="w-4 h-4" aria-hidden="true" />
            </p>
          </div>
          <div class="md:col-span-5 order-1 md:order-2">
            <Img
              sizes="(min-width: 768px) 40vw, 100vw"
              src="/illustrations/fiction-scooter-bridge.png"
              alt=""
              class="w-full h-56 md:h-full md:min-h-[320px] object-cover object-center"
            />
          </div>
        </div>
      </section>

      {/* Category filter (needs JS; without it every story simply shows) */}
      <div hidden data-filter class="mb-8">
        <div role="group" aria-label="Filter stories by category" class="flex flex-wrap gap-2">
          <button type="button" data-cat="all" aria-pressed="true" class="px-4 py-2 rounded-full text-xs font-mono uppercase tracking-wider font-bold border border-canvas-border transition-colors aria-pressed:bg-ink-900 aria-pressed:text-white aria-pressed:border-ink-900 bg-white text-ink-700 hover:border-berry-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#C2185B]">All</button>
          {categories.map((c) => (
            <button type="button" data-cat={c.key} aria-pressed="false" class="px-4 py-2 rounded-full text-xs font-mono uppercase tracking-wider font-bold border border-canvas-border transition-colors aria-pressed:bg-ink-900 aria-pressed:text-white aria-pressed:border-ink-900 bg-white text-ink-700 hover:border-berry-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#C2185B]">{c.label}</button>
          ))}
        </div>
        <p data-status aria-live="polite" class="mt-3 text-xs font-mono text-ink-600"></p>
      </div>

      {/* Grid of Stories */}
      <div data-grid class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {ESSAYS_DATA.map((essay) => (
          <a
            key={essay.slug}
            data-category={String(essay.category || '').toLowerCase()}
            href={`/stories/${essay.slug}/`}
            class="group rounded-3xl p-7 bg-white dark:bg-canvas-darkCard border border-canvas-border dark:border-canvas-darkBorder hover:border-berry-600 dark:hover:border-berry-500 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between text-xs font-mono tracking-wider mb-4">
                <span class="text-ink-500 dark:text-ink-300 font-medium">{essay.date}</span>
                <div class="flex items-center gap-1.5 text-berry-700 dark:text-berry-400 font-semibold">
                  <Clock className="w-3.5 h-3.5" />
                  <span>{essay.readTime || "6 min read"}</span>
                </div>
              </div>

              <h2 class="font-serif text-2xl font-bold text-ink-900 dark:text-white group-hover:text-berry-600 dark:group-hover:text-berry-400 transition-colors mb-3 leading-snug">
                {essay.title}
              </h2>

              <p class="text-xs sm:text-sm text-ink-600 dark:text-ink-300 font-light leading-relaxed line-clamp-3 mb-6">
                {essay.subtitle || essay.summary}
              </p>
            </div>

            <div class="pt-4 border-t border-canvas-border dark:border-canvas-darkBorder flex items-center justify-between text-xs font-mono tracking-wider font-bold text-berry-700 dark:text-berry-400">
              <span class="uppercase">READ NOTE</span>
              <ArrowUpRight className="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
            </div>
          </a>
        ))}
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  const wrap = document.querySelector('[data-filter]');
  if (wrap) {
    const buttons = [...wrap.querySelectorAll('button[data-cat]')];
    const cards = [...document.querySelectorAll('[data-grid] > [data-category]')];
    const spotlight = document.querySelector('[data-fiction-spotlight]');
    const grid = document.querySelector('[data-grid]');
    const status = wrap.querySelector('[data-status]');
    const keys = buttons.map((b) => b.dataset.cat);

    const apply = (cat, announce) => {
      let shown = 0;
      cards.forEach((c) => {
        const on = cat === 'all' || c.dataset.category === cat;
        c.hidden = !on;
        if (on) shown += 1;
      });
      if (grid) grid.hidden = shown === 0;
      if (spotlight) spotlight.hidden = !(cat === 'all' || cat === 'fiction');
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cat === cat)));
      if (status && announce) {
        const total = shown + (spotlight && !spotlight.hidden ? 1 : 0);
        status.textContent = `Showing ${total} ${total === 1 ? 'story' : 'stories'}`;
      }
    };

    wrap.hidden = false;
    const start = new URLSearchParams(location.search).get('category');
    apply(keys.includes(start) ? start : 'all', false);

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const cat = b.dataset.cat;
        apply(cat, true);
        const url = new URL(location.href);
        if (cat === 'all') url.searchParams.delete('category');
        else url.searchParams.set('category', cat);
        history.replaceState(null, '', url);
      })
    );
  }
</script>

<style is:global>
  [data-grid][hidden],
  [data-grid] > [data-category][hidden],
  [data-fiction-spotlight][hidden] {
    display: none !important;
  }
</style>
