---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.jsx';
import ValueProps from '../components/ValueProps.jsx';
import WritingBoard from '../components/WritingBoard.jsx';
import Letterbox from '../components/Letterbox.jsx';
import CoreLevers from '../components/CoreLevers.jsx';
import HomeAboutTeaser from '../components/HomeAboutTeaser.jsx';
import HomeAdvisoryTeaser from '../components/HomeAdvisoryTeaser.jsx';
---

<BaseLayout>
  <Hero client:load />
  
  <div id="desks" class="scroll-mt-20">
    <ValueProps client:load />
  </div>

  <WritingBoard client:load />
  <Letterbox client:load />
  
  <CoreLevers client:load />
  
  <HomeAboutTeaser client:load />
  <HomeAdvisoryTeaser client:load />
</BaseLayout>
