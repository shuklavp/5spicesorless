---
import DeskPage from '../components/DeskPage.jsx';
import Navbar from '../components/Navbar.jsx';
import SeoHead from '../components/SeoHead.astro';
import '../index.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead
      title="The Life Desk | 5 Spices or Less"
      description="Notes on perspective gathered in quiet corners: patience, family and roots, the courage to accept help, and leaving enough room for life to happen."
      ogKey="life"
    />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="bg-white dark:bg-[#080D18] text-[#0C1427] dark:text-white min-h-screen">
    <a href="#main" class="skip-link">Skip to main content</a>
    <Navbar client:load currentPath="/life" />
    <main id="main">
      <DeskPage client:load category="life" />
    </main>
  </body>
</html>
