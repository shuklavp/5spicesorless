---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Clock, ArrowUpRight } from 'lucide-react';
import { ESSAYS_DATA } from '../data/essays.js';
---

<BaseLayout title="Stories & Letters | 5 Spices or Less">
  <div class="min-h-screen pt-44 pb-24 px-6 md:px-12 bg-white dark:bg-canvas-dark text-ink-900 dark:text-white transition-colors duration-300">
    <div class="max-w-6xl mx-auto">
      
      {/* Header */}
      <div class="mb-14">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-berry-50 dark:bg-canvas-darkCard border border-berry-200 dark:border-canvas-darkBorder text-berry-600 dark:text-berry-400 text-xs font-mono uppercase tracking-widest font-bold mb-4">
          <span>THE STORIES &amp; LETTERS</span>
        </div>
        <h1 class="font-serif text-4xl sm:text-6xl font-black leading-tight text-ink-900 dark:text-white mb-4">
          Observations on work, kitchen, character &amp; life.
        </h1>
        <p class="text-lg text-ink-600 dark:text-ink-300 font-light max-w-2xl">
          Quiet thoughts written from Lucknow to Kuala Lumpur on what endures after the rush subsides.
        </p>
      </div>

      {/* Grid of Stories */}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {ESSAYS_DATA.map((essay) => (
          <a
            key={essay.slug}
            href={`/stories/${essay.slug}/`}
            class="group rounded-3xl p-7 bg-white dark:bg-canvas-darkCard border border-canvas-border dark:border-canvas-darkBorder hover:border-berry-600 dark:hover:border-berry-500 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between text-xs font-mono tracking-wider mb-4">
                <span class="text-ink-500 dark:text-ink-400 font-medium">{essay.date}</span>
                <div class="flex items-center gap-1.5 text-berry-600 dark:text-berry-400 font-semibold">
                  <Clock className="w-3.5 h-3.5" />
                  <span>{essay.readTime || "6 min read"}</span>
                </div>
              </div>

              <h3 class="font-serif text-2xl font-bold text-ink-900 dark:text-white group-hover:text-berry-600 dark:group-hover:text-berry-400 transition-colors mb-3 leading-snug">
                {essay.title}
              </h3>

              <p class="text-xs sm:text-sm text-ink-600 dark:text-ink-300 font-light leading-relaxed line-clamp-3 mb-6">
                {essay.subtitle || essay.summary}
              </p>
            </div>

            <div class="pt-4 border-t border-canvas-border dark:border-canvas-darkBorder flex items-center justify-between text-xs font-mono tracking-wider font-bold text-berry-600 dark:text-berry-400">
              <span class="uppercase">READ NOTE</span>
              <ArrowUpRight className="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
            </div>
          </a>
        ))}
      </div>

    </div>
  </div>
</BaseLayout>
