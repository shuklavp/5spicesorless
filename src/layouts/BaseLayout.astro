---
import Navbar from '../components/Navbar.jsx';
import Footer from '../components/Footer.jsx';
import '../index.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  activeCategory?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  publishDate?: string;
}

const {
  title = "5 Spices or Less | Vivek Shukla: The Philosophy of Simplification",
  description = "Essays on enterprise building, Awadhi kitchens, and living with patience. Published by Vivek Shukla from Kuala Lumpur.",
  image = "https://5spicesorless.com/branding/logo.png",
  activeCategory = "",
  canonicalUrl = Astro.url.href,
  type = "website",
  publishDate,
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteUrl = "https://5spicesorless.com";

// Base JSON-LD schema
const schemaOrg = type === 'article' ? {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "image": image,
  "datePublished": publishDate || new Date().toISOString(),
  "author": {
    "@type": "Person",
    "name": "Vivek Shukla",
    "url": `${siteUrl}/about`
  },
  "publisher": {
    "@type": "Organization",
    "name": "5 Spices or Less",
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/branding/logo.png`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  }
} : {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "5 Spices or Less",
  "url": siteUrl,
  "description": description,
  "author": {
    "@type": "Person",
    "name": "Vivek Shukla",
    "jobTitle": "Venture Advisor & Author",
    "url": `${siteUrl}/about`
  }
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="5 Spices or Less" />
    {publishDate && <meta property="article:published_time" content={publishDate} />}
    {type === 'article' && <meta property="article:author" content="Vivek Shukla" />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- RSS Feed Autodiscovery -->
    <link rel="alternate" type="application/rss+xml" title="5 Spices or Less - Stories & Essays" href="/rss.xml" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-canvas dark:bg-canvas-dark text-ink-900 dark:text-white antialiased transition-colors duration-300 min-h-screen flex flex-col justify-between selection:bg-berry-500 selection:text-white">
    <Navbar client:load currentPath={currentPath} activeCategory={activeCategory} />
    
    <main class="flex-grow">
      <slot />
    </main>

    <Footer client:load />

    <!-- Privacy-friendly, Cookieless Analytics (Cloudflare Beacon) -->
    <!-- When deploying, insert your token or keep as a clean zero-cookie script -->
  </body>
</html>
