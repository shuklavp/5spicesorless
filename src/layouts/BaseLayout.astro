---
import Navbar from '../components/Navbar.jsx';
import Footer from '../components/Footer.jsx';
import SeoHead from '../components/SeoHead.astro';
import '../index.css';
import '../styles/fonts-fraunces.css';

interface Props {
  title?: string;
  description?: string;
  ogKey?: string;
  activeCategory?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  publishDate?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const {
  title = "5 Spices or Less | Vivek Shukla: The Philosophy of Simplification",
  description = "Essays on life, food and work from Vivek Shukla, and calm advisory for founders. Radical simplicity, drawn from thirty years of building businesses.",
  ogKey = "default",
  activeCategory = "",
  canonicalUrl,
  type = "website",
  publishDate,
  noindex = false,
  jsonLd = [],
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead
      title={title}
      description={description}
      ogKey={ogKey}
      type={type}
      publishDate={publishDate}
      canonicalUrl={canonicalUrl}
      noindex={noindex}
      jsonLd={jsonLd}
    />

    <!-- RSS Feed Autodiscovery -->
    <link rel="alternate" type="application/rss+xml" title="5 Spices or Less - Stories & Essays" href="/rss.xml" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Typography: self-hosted (see src/styles). Preload the two faces used above the fold. -->
    <link rel="preload" href="/fonts/fraunces-latin-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="bg-canvas dark:bg-canvas-dark text-ink-900 dark:text-white antialiased transition-colors duration-300 min-h-screen flex flex-col justify-between selection:bg-berry-500 selection:text-white">
    <a href="#main" class="skip-link">Skip to main content</a>
    <Navbar client:load currentPath={currentPath} activeCategory={activeCategory} />
    
    <main id="main" class="flex-grow">
      <slot />
    </main>

    <Footer client:load />

    <!-- Privacy-friendly, Cookieless Analytics (Cloudflare Beacon) -->
    <!-- When deploying, insert your token or keep as a clean zero-cookie script -->
  </body>
</html>
